  "notes": [],
  "steps": [
    {
      "id": "s1",
      "instruction": "STEP 1 - MARINATING THE CHICKEN\nIn a bowl, add chicken, salt, white pepper, ginger juice and then mix it together well.",
      "depends_on": []
    },
    {
      "id": "s2",
      "instruction": "Set the chicken aside.",
      "depends_on": [
        "s1"
      ]
    },
    {
      "id": "s3",
      "instruction": "STEP 2 - RINSE THE WHITE RICE\nRinse the rice in a metal bowl or pot a couple times and then drain the water.",
      "depends_on": [
        "s2"
      ]
    },
    {
      "id": "s4",
      "instruction": "STEP 2 - BOILING THE WHITE RICE\nNext add 8 cups of water and then set the stove on high heat until it is boiling. Once rice porridge starts to boil, set the stove on low heat and then stir it once every 8-10 minutes for around 20-25 minutes.",
      "depends_on": [
        "s3"
      ]
    },
    {
      "id": "s5",
      "instruction": "After 25 minutes, this is optional but you can add a little bit more water to make rice porridge to make it less thick or to your preference.",
      "depends_on": [
        "s4"
      ]
    },
    {
      "id": "s6",
      "instruction": "Next add the marinated chicken to the rice porridge and leave the stove on low heat for another 10 minutes.",
      "depends_on": [
        "s5"
      ]
    },
    {
      "id": "s7",
      "instruction": "After an additional 10 minutes add the green onions, sliced ginger, 1 pinch of salt, 1 pinch of white pepper and stir for 10 seconds.",
      "depends_on": [
        "s6"
      ]
    },
    {
      "id": "s8",
      "instruction": "Serve the rice porridge in a bowl",
      "depends_on": [
        "s7"
      ]
    },
    {
      "id": "s9",
      "instruction": "Optional: add Coriander on top of the rice porridge.",
      "depends_on": [
        "s8"
      ]
    }
  ],
