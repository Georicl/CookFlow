  "notes": [
    "You can also use sugar snap peas for this recipe. Save prep time by prepping the peas, ginger, and garlic while the shrimp is marinating."
  ],
  "steps": [
    {
      "id": "s1",
      "instruction": "Marinate the shrimp:\nMix all marinade ingredients in a large bowl, then add the shrimp. Toss to coat. Let sit for 15 to 20 minutes while you prep the peas, ginger, and garlic.",
      "depends_on": []
    },
    {
      "id": "s2",
      "instruction": "Stir-fry the ginger and garlic:\nHeat a wok or large sauté pan over high heat for 1 minute. Add the peanut oil and let it get hot, about 30 seconds. Add the ginger and garlic and toss to combine. Stir-fry for about 30 seconds.",
      "depends_on": [
        "s1"
      ]
    },
    {
      "id": "s3",
      "instruction": "Add the shrimp, snow peas, soy sauce, stock:\nAdd the shrimp and all the marinade to the pan (scrape out all the marinade with a rubber spatula). Add the snow peas, soy sauce and chicken stock. Stir-fry until the shrimp turns pink, about 2 minutes.",
      "depends_on": [
        "s2"
      ]
    },
    {
      "id": "s4",
      "instruction": "Add the scallions and finish with sesame oil:\nAdd the scallions and stir-fry 1 more minute. Turn off the heat and add the sesame oil. Toss to combine once more and serve with steamed rice.",
      "depends_on": [
        "s3"
      ]
    }
  ],
