  "notes": [],
  "steps": [
    {
      "id": "s1",
      "instruction": "Preparation\n1. Crack the egg into a bowl. Separate the egg white and yolk.",
      "depends_on": []
    },
    {
      "id": "s2",
      "instruction": "2. Slice the pork tenderloin into strips.",
      "depends_on": [
        "s1"
      ]
    },
    {
      "id": "s3",
      "instruction": "3. Prepare the marinade using a pinch of salt, one teaspoon of starch, two teaspoons of light soy sauce, and an egg white.",
      "depends_on": [
        "s2"
      ]
    },
    {
      "id": "s4",
      "instruction": "4. Marinade the pork strips for about 20 minutes.",
      "depends_on": [
        "s3"
      ]
    },
    {
      "id": "s5",
      "instruction": "5. Put the remaining starch in a bowl. Add some water and vinegar to make a starchy sauce.",
      "depends_on": [
        "s4"
      ]
    },
    {
      "id": "s6",
      "instruction": "Cooking Instructions\n1. Pour the cooking oil into a wok and heat to 190°C (375°F). Add the marinated pork strips and fry them until they turn brown. Remove the cooked pork from the wok and place on a plate.",
      "depends_on": [
        "s5"
      ]
    },
    {
      "id": "s7",
      "instruction": "2. Leave some oil in the wok. Put the tomato sauce and white sugar into the wok, and heat until the oil and sauce are fully combined.",
      "depends_on": [
        "s6"
      ]
    },
    {
      "id": "s8",
      "instruction": "3. Add some water to the wok and thoroughly heat the sweet and sour sauce before adding the pork strips to it.",
      "depends_on": [
        "s7"
      ]
    },
    {
      "id": "s9",
      "instruction": "4. Pour in the starchy sauce. Stir-fry all the ingredients until the pork and sauce are thoroughly mixed together.",
      "depends_on": [
        "s8"
      ]
    },
    {
      "id": "s10",
      "instruction": "5. Serve on a plate and add some coriander for decoration.",
      "depends_on": [
        "s9"
      ]
    }
  ],
